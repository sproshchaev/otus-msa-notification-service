        <mxCell id="c5" value="email через SMTP" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="app" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="SMS через HTTP API" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="app" target="sms">
