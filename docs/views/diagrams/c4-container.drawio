<mxfile host="app.diagrams.net" type="device">
  <diagram name="C4-Container" id="c4-container">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="senders" value="Внутренние системы-отправители&#10;[внешние]&#10;монолит, CRM, маркетинг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="boundary" value="Сервис уведомлений (система)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#0b4884;fontColor=#0b4884;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="720" height="360" as="geometry" />
        </mxCell>

        <mxCell id="app" value="notification-service&#10;[приложение, Spring Boot]&#10;приём, диспетчеризация, доставка;&#10;stateless, работает в N копиях" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL&#10;[база данных]&#10;заявки, история статусов,&#10;записи DLQ, маршрутизация" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mq" value="RabbitMQ&#10;[брокер сообщений]&#10;очередь диспетчера,&#10;retry, dead-letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="385" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="providers" value="Внешние провайдеры" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6b6b6b;fontColor=#6b6b6b;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="190" height="200" as="geometry" />
        </mxCell>
        <mxCell id="smtp" value="SMTP-сервер&#10;[внешний]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="820" y="240" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sms" value="SMS-провайдер&#10;[внешний]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="POST /notifications&#10;(HTTPS/JSON, токен)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="senders" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="заявка + статусы&#10;(1 транзакция)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="app" target="db">
          <mxGeometry relative="1" as="geometry" />
