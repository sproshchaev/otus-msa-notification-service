        <mxCell id="c3" value="публикация (publish)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="app" target="mq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="на обработку (consume)" style="endArrow=block;html=1;fontSize=10;dashed=1;exitX=0.4;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="mq" target="app">
          <mxGeometry relative="1" as="geometry" />
